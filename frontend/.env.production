# Baked into the production build (used by Vite when running `npm run build`).
#
# This is the absolute URL the bundled APK will hit at runtime. There is no
# Vite proxy in production, so an absolute URL is required.
#
# Set this to the public URL of your deployed FastAPI backend (Render / Fly /
# Railway). After deploying, replace the placeholder below and rebuild:
#
#   cd frontend && npm run build
#   cd ../../personal/signals && ./scripts/build-apk.ps1
#
# Note: the leading https:// is required; Capacitor on Android will block
# cleartext requests by default (allowMixedContent: false in capacitor.config).
VITE_API_BASE_URL=https://signals-backend.onrender.com
