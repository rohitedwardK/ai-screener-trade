# --- Database ---
DB_URL=sqlite:///./screener.db

# --- Data fetching ---
HISTORY_PERIOD=5y
INTERVAL=1d

# --- Scheduler (cron in IST) ---
REFRESH_CRON_HOUR=18
REFRESH_CRON_MINUTE=30
ENABLE_SCHEDULER=true

# --- LLM provider: template | ollama | openai ---
LLM_PROVIDER=template

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Timeout for the chat call. Local CPU inference of a 3B+ model can take
# >60s for a multi-paragraph answer; raise this if you see template fallbacks.
OLLAMA_TIMEOUT_SECONDS=180

# OpenAI / OpenAI-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Live Analysis Mode (Upstox-backed real-time, simulation only) ---
# Upstox v2 access tokens expire daily ~03:30 IST; refresh manually or via OAuth.
# When the token is missing/expired, the engine falls back to yfinance (15-min
# delayed) and logs a warning. Live mode is ANALYSIS only - no broker orders.
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v2

LIVE_ANALYSIS_ENABLED=true
LIVE_ANALYSIS_POLL_MIN=3
LIVE_ANALYSIS_OBS_SAMPLES=6
LIVE_ANALYSIS_TOP_K=8
LIVE_ANALYSIS_COOLDOWN_MIN=30
