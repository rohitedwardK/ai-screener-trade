# Local development uses the Vite dev proxy (see vite.config.ts), so the
# VITE_API_BASE_URL env var is normally unnecessary for `npm run dev`.
#
# It IS required for production builds that target the Capacitor APK or any
# remote host, because the bundle has no proxy. See .env.production for the
# deployed value.
#
# Optional override for `npm run dev` (rarely needed):
# VITE_API_BASE_URL=http://127.0.0.1:8000
